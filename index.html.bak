<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PrajnaEdge | Devaharsha Meesarapu</title>
<meta name="description" content="PrajnaEdge explores embedded systems, firmware architecture, Edge AI, and intelligent computation through systems thinking." />
<meta name="author" content="Devaharsha Meesarapu" />
<link rel="canonical" href="https://prajnaedge.dev/" />
<meta name="robots" content="index, follow" />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://prajnaedge.dev/" />
<meta property="og:title" content="PrajnaEdge | Devaharsha Meesarapu" />
<meta property="og:description" content="PrajnaEdge explores embedded systems, firmware architecture, Edge AI, and intelligent computation through systems thinking." />
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://prajnaedge.dev/" />
<meta property="twitter:title" content="PrajnaEdge | Devaharsha Meesarapu" />
<meta property="twitter:description" content="PrajnaEdge explores embedded systems, firmware architecture, Edge AI, and intelligent computation through systems thinking." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght=600;700;800&family=DM+Sans:wght=300;400;500&family=IBM+Plex+Mono:wght=400;500&display=swap" rel="stylesheet" />
  <!-- External Premium Stylesheet -->
  <link rel="stylesheet" href="style.css" />
  <!-- External Behavior and Logic -->
  <script src="script.js" defer></script>
  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-6Y8ZVQB1V0"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-6Y8ZVQB1V0');
</script>
</head>
<body>

<nav>
  <div class="nav-links">
    <a id="nav-home" class="active" onclick="showPage('home')">Home</a>
    <a id="nav-blogs" onclick="openDirectExplorations()">Exploration</a>
    <a id="nav-demos" onclick="showPage('demos')">Demonstration</a>
    <a id="nav-about" onclick="showPage('about')">About</a>
    <a id="nav-contact" onclick="showPage('contact')">Contact</a>
  </div>
</nav>

<div class="page active" id="page-home">
  <div class="empty-page">
    <div class="empty-title">From Matter to Machines</div>
    <div class="empty-sub" style="max-width:580px;text-align:center;line-height:1.7;color:var(--text);margin-top:0.5rem">
      PrajnaEdge is an embedded systems knowledge library created by Devaharsha Meesarapu, exploring how modern machines evolve—from matter and computation to interaction, coordination and integration.
    </div>
    <div style="font-size:0.8rem;color:var(--muted);font-family:var(--mono);margin-top:0.75rem">
      Follow the awakened trunk to begin exploring.
    </div>
    <!-- Animated Banyan Tree Viewport -->
    <div class="tree-viewport" id="tree-viewport">
      <div class="tree-tooltip" id="tree-tooltip"></div>
      
      <!-- Sway wrapper (rotates the whole tree) -->
      <div class="tree-sway-wrap sway">
        <!-- SVG container holding both images and interactive hotspots to guarantee perfect alignment -->
        <svg id="tree-svg" viewBox="0 0 1536 1024" class="tree-svg-overlay" style="pointer-events: auto;">
          <defs>
            <filter id="mask-blur-filter">
              <feGaussianBlur stdDeviation="28" />
            </filter>
            <mask id="sap-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1536" height="1024">
              <!-- Black background (transparent) -->
              <rect width="1536" height="1024" fill="black" />
              <!-- White path drawings (reveal the foreground tree) -->
              <g fill="none" stroke="white" stroke-linecap="round" filter="url(#mask-blur-filter)">
                <!-- Roots (flow inwards & upwards) -->
                <g stroke-width="160" class="mask-path-roots">
                  <path d="M765,737 C600,810 350,880 120,900" />
                  <path d="M765,737 C680,820 500,900 350,960" />
                  <path d="M765,737 C740,840 700,900 680,980" />
                  <path d="M765,737 C790,840 830,900 850,980" />
                  <path d="M765,737 C850,820 980,900 1100,960" />
                  <path d="M765,737 C880,820 1100,900 1350,900" />
                  <!-- Extra root branches to fully cover base -->
                  <path d="M765,737 C720,830 620,910 550,980" />
                  <path d="M765,737 C810,830 910,910 980,980" />
                </g>
                <!-- Computation -->
                <path d="M765,737 C770,710 774,685 777,665" stroke-width="150" class="mask-path-computation" />
                <!-- Interaction -->
                <path d="M777,665 C782,630 790,595 797,563" stroke-width="140" class="mask-path-interaction" />
                <!-- Coordination -->
                <path d="M797,563 C795,530 790,495 785,460" stroke-width="130" class="mask-path-coordination" />
                <!-- Integration -->
                <path d="M785,460 C775,425 765,390 754,358" stroke-width="120" class="mask-path-integration" />
              </g>
            </mask>
          </defs>

          <!-- LAYER 1: Muted desaturated dormant background image -->
          <image href="Images/homeTree.png" x="0" y="0" width="1536" height="1024" class="tree-img-muted" />

          <!-- LAYER 2: Warm glowing awakened foreground image (masked) -->
          <image href="Images/homeTree.png" x="0" y="0" width="1536" height="1024" mask="url(#sap-mask)" class="tree-img-warm" />

          <!-- LAYER 3: INVISIBLE INTERACTION HOTSPOTS -->
          <g id="hotspots" fill="none" stroke="transparent" stroke-linecap="round" style="pointer-events: auto;">
            <!-- Matter (Roots) -->
            <g id="hotspot-Matter" class="tree-hotspot-group">
              <path d="M200,950 C400,900 650,820 765,737" stroke-width="115" />
              <path d="M450,980 C550,920 700,830 765,737" stroke-width="115" />
              <path d="M720,990 C730,920 750,850 765,737" stroke-width="115" />
              <path d="M810,990 C800,920 780,850 765,737" stroke-width="115" />
              <path d="M1050,980 C950,920 830,830 765,737" stroke-width="115" />
              <path d="M1350,950 C1100,900 880,820 765,737" stroke-width="115" />
            </g>
            <!-- Trunk segments -->
            <g id="hotspot-Computation" class="tree-hotspot-group">
              <path d="M765,737 C770,710 774,685 777,665" stroke-width="135" />
            </g>
            <g id="hotspot-Interaction" class="tree-hotspot-group">
              <path d="M777,665 C782,630 790,595 797,563" stroke-width="130" />
            </g>
            <g id="hotspot-Coordination" class="tree-hotspot-group">
              <path d="M797,563 C795,530 790,495 785,460" stroke-width="122" />
            </g>
            <g id="hotspot-Integration" class="tree-hotspot-group">
              <path d="M785,460 C775,425 765,390 754,358" stroke-width="115" />
            </g>
          </g>
        </svg>
      </div>

      <!-- Cinematic Vignette Overlay -->
      <div class="cinematic-vignette"></div>

      <!-- Background glow overlays -->
      <div class="root-spark"></div>
      <div class="roots-spreading"></div>
      <div class="trunk-glow"></div>
      <div class="left-branch-glow"></div>
      <div class="right-branch-glow"></div>
      <div class="canopy-glow"></div>
      <div class="ground-shadow"></div>

      <!-- Floating golden motes -->
      <div class="motes-container">
        <div class="mote" style="left:42.3%; top:78%; --sz:1.8px; --dur:8.2s; --dl:4.1s; --op:0.22; --dr:-3px;"></div>
        <div class="mote" style="left:56.1%; top:82%; --sz:1.4px; --dur:9.5s; --dl:5.3s; --op:0.18; --dr:2px;"></div>
        <div class="mote" style="left:48.7%; top:75%; --sz:2.1px; --dur:7.8s; --dl:3.8s; --op:0.24; --dr:-1px;"></div>
        <div class="mote" style="left:53.4%; top:80%; --sz:1.6px; --dur:10.2s; --dl:6.0s; --op:0.20; --dr:3px;"></div>
        <div class="mote" style="left:44.2%; top:85%; --sz:1.3px; --dur:8.8s; --dl:4.5s; --op:0.16; --dr:-4px;"></div>
        <div class="mote" style="left:60.8%; top:79%; --sz:2.0px; --dur:9.1s; --dl:5.8s; --op:0.21; --dr:4px;"></div>
        <div class="mote" style="left:38.5%; top:83%; --sz:1.5px; --dur:7.5s; --dl:7.2s; --op:0.17; --dr:-2px;"></div>
        <div class="mote" style="left:50.2%; top:72%; --sz:1.9px; --dur:11.0s; --dl:3.5s; --op:0.20; --dr:1px;"></div>
        <div class="mote" style="left:55.6%; top:86%; --sz:1.2px; --dur:8.5s; --dl:8.0s; --op:0.15; --dr:5px;"></div>
        <div class="mote" style="left:46.4%; top:88%; --sz:2.0px; --dur:9.8s; --dl:4.8s; --op:0.23; --dr:-3px;"></div>
        <div class="mote" style="left:52.1%; top:74%; --sz:1.6px; --dur:8.0s; --dl:6.5s; --op:0.19; --dr:2px;"></div>
        <div class="mote" style="left:40.9%; top:77%; --sz:1.4px; --dur:10.5s; --dl:5.1s; --op:0.16; --dr:-5px;"></div>
        <div class="mote" style="left:58.3%; top:81%; --sz:1.8px; --dur:7.2s; --dl:7.8s; --op:0.21; --dr:3px;"></div>
        <div class="mote" style="left:47.7%; top:90%; --sz:1.3px; --dur:9.3s; --dl:9.2s; --op:0.15; --dr:-1px;"></div>
        <div class="mote" style="left:54.5%; top:76%; --sz:2.0px; --dur:8.7s; --dl:5.6s; --op:0.24; --dr:4px;"></div>
        <div class="mote" style="left:43.8%; top:84%; --sz:1.7px; --dur:10.0s; --dl:7.5s; --op:0.19; --dr:-4px;"></div>
        <div class="mote" style="left:49.3%; top:87%; --sz:1.5px; --dur:9.0s; --dl:4.2s; --op:0.17; --dr:2px;"></div>
        <div class="mote" style="left:57.2%; top:78%; --sz:1.8px; --dur:8.3s; --dl:6.8s; --op:0.22; --dr:-2px;"></div>
        <div class="mote" style="left:45.1%; top:80%; --sz:1.2px; --dur:11.2s; --dl:8.5s; --op:0.14; --dr:5px;"></div>
        <div class="mote" style="left:51.5%; top:83%; --sz:2.1px; --dur:7.9s; --dl:3.9s; --op:0.26; --dr:-3px;"></div>
      </div>
    </div>

    <div style="margin-top:3.5rem;text-align:center">
      <div style="font-size:0.8rem;color:var(--muted);font-family:'Syne',sans-serif;font-weight:600;margin-bottom:1rem">Active Production</div>
      <div style="display:inline-block;opacity:0.85;border:1px solid var(--blue);border-radius:8px;padding:0.85rem 1.5rem;text-align:left;min-width:200px;cursor:default;transition:all 0.2s;background:var(--blue-glow);"
           onmouseover="this.style.borderColor='var(--blue)'">
        <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:0.95rem;color:#FFF;margin-bottom:0.3rem">PravahaPath</div>
        <div style="font-family:var(--mono);font-size:0.65rem;color:var(--blue);letter-spacing:0.08em">Spinning up product pipeline</div>
      </div>
    </div>
  </div>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>

<div class="page" id="page-blogs">
  <div style="padding-top:80px;min-height:100vh">
    <div style="max-width:760px;margin:0 auto;padding:3rem 2.5rem">
      
      <button id="blogsBackToTreeBtn" class="blog-back-btn" style="display:none;" onclick="clearBlogFilterAndGoHome()">← Back to Systems Tree</button>

      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2.5rem;">
        <div>
          <h2 class="section-title" id="blogsPageTitle" style="margin-bottom:0.25rem">Articles &amp; Write-ups</h2>
          <p style="color:var(--muted);font-family:var(--mono);font-size:0.8rem" id="blogsPageSubtitle">
            Exploring how systems evolve from hardware to integration.
          </p>
        </div>
        
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <div class="control-housing">
            <span class="control-label">Sort:</span>
            <select id="blogSortOrderSelect" class="select-dark" onchange="handleSortChange('blogs')">
              <option value="newest">Newest First</option>
              <option value="oldest">Oldest First</option>
            </select>
          </div>
        </div>
      </div>
      <div id="blogList" style="display:flex;flex-direction:column;gap:1.25rem"></div>
    </div>
  </div>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>

<div class="page" id="page-demos">
  <div style="padding-top:80px;min-height:100vh">
    <div style="max-width:760px;margin:0 auto;padding:3rem 2.5rem">
      
      <button id="demosBackToTreeBtn" class="blog-back-btn" style="display:none;" onclick="clearDemoFilterAndGoHome()">← Back to Systems Tree</button>

      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2.5rem;">
        <div>
          <h2 class="section-title" id="demosPageTitle" style="margin-bottom:0.25rem">Edge AI Demonstrations</h2>
          <p style="color:var(--muted);font-family:var(--mono);font-size:0.8rem" id="demosPageSubtitle">
            Deploying neural networks and intelligent decision loops on raw silicon targets.
          </p>
        </div>
        
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <div class="control-housing">
            <span class="control-label">Sort:</span>
            <select id="demoSortOrderSelect" class="select-dark" onchange="handleSortChange('demos')">
              <option value="newest">Newest First</option>
              <option value="oldest">Oldest First</option>
            </select>
          </div>

          <button id="clearDemoFilterBtn" class="tag" style="display:none; padding:0.45rem 0.85rem; cursor:pointer; color:var(--blue); border-color:rgba(59,130,246,0.3); background:var(--blue-glow);" onclick="clearDemoFilter()">
            Clear Filter [x]
          </button>
        </div>
      </div>
      <div id="demoList" style="display:flex;flex-direction:column;gap:1.25rem"></div>
    </div>
  </div>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>

<div class="page" id="page-blog-post">
  <div style="padding-top:80px">
    <div style="max-width:760px;margin:0 auto;padding:3rem 2.5rem 5rem">
      <button id="readerBackBtn" class="blog-back-btn" onclick="showPage('blogs')">← Back to Exploration</button>
      <div id="blog-post-content"></div>
    </div>
  </div>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>

<div class="page" id="page-about">
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid">
      <div>
        <div class="hero-tag">Embedded Firmware Engineer</div>
        <h1 class="hero-title">
          Building <em>Intelligent Systems</em><br>from Silicon to Edge AI
        </h1>
        <p class="hero-sub">
          Embedded Firmware Engineer focused on real-time systems, hardware-software integration,
          and Edge AI. Engineering from the ground up — one register at a time.
        </p>
        <div class="hero-btns">
          <a href="https://drive.google.com/file/d/1Whn_zQ9lPUEpp2J3lTxFOTH2K57erQVp/view"
             target="_blank" rel="noopener noreferrer" class="btn-primary"
             onmouseover="this.style.transform='translateY(-2px) scale(1.03)'"
             onmouseout="this.style.transform='translateY(0) scale(1)'">
            View Resume →
          </a>
          <button class="btn-ghost" onclick="showPage('journey')">Explore My Journey ↓</button>
        </div>
      </div>
    </div>
  </section>
  <section id="about">
    <div class="section-label">// about</div>
    <div class="about-grid">
      <div>
        <h2 class="section-title">Where Hardware Meets Intelligence</h2>
        <p class="about-text">
          PrajnaEdge is a systems exploration project by Devaharsha Meesarapu.<br><br>
          I work on low-level systems where hardware meets software, building reliable real-time embedded systems while exploring the evolution of intelligent edge systems.<br><br>
          My work spans electronics, embedded firmware, system architecture, and artificial intelligence—a deliberate journey from understanding silicon to understanding intelligence.
        </p>
      </div>
      <div class="why-card">
        <div class="why-title">Why This Site Exists</div>
        <p class="why-text">
          This is not just a portfolio. It is a space where I explore, document, and simplify
          how systems evolve from hardware to intelligent behavior.<br><br>
          Every section is a layer of the stack — from the transistor to the trained model.
          The goal is to make the journey from silicon to edge AI legible.
        </p>
      </div>
    </div>
  </section>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>

<div class="page" id="page-journey">
  <section id="journey-section">
    <div class="journey-inner">
      <div class="section-label">// career_journey</div>
      <h2 class="section-title">Interactive Career Journey</h2>
      <div class="node-selector" id="node-selector"></div>
      <div class="journey-content">
        <div class="node-meta fade-in" id="node-meta"></div>
        <div class="node-cards fade-in" id="node-cards"></div>
      </div>
    </div>
  </section>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>

<div class="page" id="page-contact">
  <section class="empty-page">
    <div class="empty-title">Let's Connect</div>
    <div class="empty-sub">
      If you're working on systems, intelligence, or something in between — I'd like to hear about it.
    </div>
    <div style="margin-top:2.5rem;display:flex;gap:1rem;flex-wrap:wrap;justify-content:center">
      <a href="https://www.linkedin.com/in/devaharsham/" target="_blank" rel="noopener noreferrer"
         class="info-card" style="cursor:pointer;text-decoration:none;display:block">
        LinkedIn<br><span style="color:#64748B">View profile</span>
      </a>
      <a href="https://github.com/DevaharshaM" target="_blank" rel="noopener noreferrer"
         class="info-card" style="cursor:pointer;text-decoration:none;display:block">
        GitHub<br><span style="color:#64748B">Explore work</span>
      </a>
      <a href="mailto:meesarapud@gmail.com"
         class="info-card" style="cursor:pointer;text-decoration:none;display:block">
        Email<br><span style="color:#64748B">Send message</span>
      </a>
    </div>
    <div style="margin-top:2rem;font-size:0.8rem;color:#64748B">
      Open to conversations, ideas, and interesting problems.
    </div>
    <div style="margin-top:3rem;width:100%;max-width:480px">
      <div style="font-family:var(--mono);font-size:0.7rem;color:var(--muted);letter-spacing:0.08em;margin-bottom:0.75rem">
        // leave feedback
      </div>
      <form id="feedback-form" class="feedback-form">
        <textarea name="feedback" id="feedback-textarea" rows="4" placeholder="Share feedback or suggestions..."
          style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:#E2E8F0;font-family:'DM Sans',sans-serif;font-size:0.9rem;padding:0.85rem 1rem;resize:vertical;outline:none;box-sizing:border-box;line-height:1.6"
          onfocus="this.style.borderColor='var(--blue)'"
          onblur="this.style.borderColor='var(--border)'"></textarea>
        <button type="submit" class="btn-primary" style="margin-top:0.75rem">
          Send Feedback →
        </button>
      </form>
    </div>
  </section>
  <footer><p class="footer-text">// built with engineering thinking • Devaharsha © 2026</p></footer>
</div>



</body>
</html>
